# Swift Package Manager build output
.build/
.swiftpm/

# Assembled app bundle (produced by ./build.sh)
Recorder.app/

# macOS
.DS_Store

# Xcode
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
xcuserdata/

# Local recordings (in case anyone runs from inside the repo)
Recordings/
*.caf
*.m4a

# Icon build scratch (icon.swift + Recorder.icns are committed; these are regenerable)
icon-work/
Recorder.iconset/
Recorder-1024.png

# Meeting content and biometric data must stay outside version control
*.wav
*.mp3
*.flac
transcript.json
transcript.md
summary.json
summary.md
profiles.json
*.safetensors
*.mlmodelc/
*.mlpackage/

# Meeting metadata and complete result generations
meeting.json
current-result.json
current-summary.json
Results/
Summaries/

# Environment files: no exceptions, including examples and nested variants
.[eE][nN][vV]*
*.[eE][nN][vV]
*.[eE][nN][vV].*
.envrc
.direnv/

# Credentials, private keys and signing material
credentials*
secrets*
.secret*
.git-credentials
.netrc
.npmrc
.pypirc
.aws/
.ssh/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
id_rsa*
id_ed25519*

# Private runtime data and exports (also when accidentally copied into the repo)
TaskInbox/
inbox.json
processing-queue.json
profiles.json.*
*.csv
*.aac
*.aiff
*.aif
*.ogg
*.opus

# Infrastructure state may contain plaintext credentials
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

# Local Python scanner/test caches
__pycache__/
*.py[cod]
